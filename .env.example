# Public application URL. The Google OAuth callback is APP_BASE_URL/api/auth/google/callback.
APP_BASE_URL=http://localhost:5173
APP_ENV=development
API_BIND_ADDR=127.0.0.1:8080

# Google OAuth: configure your own client and choose who can create decks.
# Set a Workspace domain OR comma-separated verified Google email addresses.
# Audience members join with a room code and do not need Google accounts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=
GOOGLE_ALLOWED_EMAILS=

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/interdeck

# npm run setup generates independent random values. Production rejects placeholders.
INTERNAL_SERVICE_TOKEN=development-internal-token
SLIDEV_TOKEN_SECRET=development-slidev-token-secret

# Local storage requires a persistent volume in production. For multiple API
# replicas, configure all S3 values instead and leave ASSET_STORAGE blank.
ASSET_STORAGE=local
ASSET_LOCAL_DIR=.interdeck/assets
ASSET_S3_BUCKET=
ASSET_S3_ENDPOINT=
ASSET_S3_REGION=auto
ASSET_S3_ACCESS_KEY_ID=
ASSET_S3_SECRET_ACCESS_KEY=
ASSET_S3_URL_STYLE=virtual

# 0 retains audience responses until the owner deletes the deck or the operator
# removes them. Positive days prune inactive participants and AI insight history
# on decks without a live presentation. Backups need their own retention policy.
AUDIENCE_DATA_RETENTION_DAYS=0

# Optional Gemini Q&A moderation. Without the moderator key, questions use the
# manual queue and no audience submission is blocked or degraded. "assist" only
# labels and summarizes; "enforce" may approve/reject pending questions while
# still preserving human overrides and an audit history.
GEMINI_MODERATOR_KEY=
GEMINI_MODERATOR_MODEL=gemini-3.7-flash
AI_MODERATION_MODE=assist
AI_WORKER_CONCURRENCY=4

# Reserved for the constrained Slidev authoring assistant. This is deliberately
# separate so its permissions and usage budget can be managed independently.
GEMINI_ASSISTANT_KEY=
GEMINI_SLIDE_MODEL=gemini-3.7-flash

# Gateway
# Direct development traffic trusts no forwarded client-IP headers. The
# production Compose default trusts exactly one HTTPS proxy; adjust only for
# a fixed, trusted proxy chain and keep the gateway inaccessible to clients.
GATEWAY_TRUST_PROXY=
GATEWAY_AUTH_REQUESTS_PER_MINUTE=60
GATEWAY_SOURCE_REQUESTS_PER_MINUTE=60
GATEWAY_EXPORT_REQUESTS_PER_MINUTE=5000
GATEWAY_STATIC_REQUESTS_PER_MINUTE=20000
PORT=3000
INTERNAL_API_BASE=http://127.0.0.1:8080
WEB_DIST_DIR=../../../apps/web/dist
SLIDEV_IDLE_TTL_SECONDS=600
SLIDEV_MAX_SERVERS=4
SLIDEV_TOKIO_WORKER_THREADS=2
SLIDEV_RAYON_NUM_THREADS=2
RUST_LOG=interdeck=debug,tower_http=info
